# Copy this file to .env.test to run `pnpm test:integration` for @byline/cli.
#
# These are ADMIN connection strings, not application ones: the suite
# creates and drops its own `byline_cli_*_test` databases and roles, so it
# needs an account with permission to do so. Point them at a local
# development server — never a shared or production one.
#
# The defaults below match the containers in `postgres/docker-compose.yml`
# (superuser `postgres`, password `test`) and `mysql/docker-compose.yml`
# (`root`, password `test`).
#
# CI does not use this file; `.github/workflows/ci.yml` supplies both
# variables through the job-level `env:` block instead.
BYLINE_CLI_POSTGRES_ADMIN_URL=postgres://postgres:test@127.0.0.1:5432/postgres
BYLINE_CLI_MYSQL_ADMIN_URL=mysql://root:test@127.0.0.1:3306/mysql
