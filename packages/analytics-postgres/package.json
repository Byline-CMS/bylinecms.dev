{
  "name": "@byline/analytics-postgres",
  "private": false,
  "license": "MPL-2.0",
  "version": "4.16.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "PostgreSQL storage driver for Byline analytics",
  "keywords": [
    "cms",
    "analytics",
    "postgres",
    "privacy"
  ],
  "homepage": "https://github.com/Byline-CMS/bylinecms.dev",
  "bugs": {
    "url": "https://github.com/Byline-CMS/bylinecms.dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byline-CMS/bylinecms.dev.git",
    "directory": "packages/analytics-postgres"
  },
  "type": "module",
  "main": "dist/index.js",
  "index": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "chokidar 'src/**/*' -c 'npm-run-all build'",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "clean": "node scripts/clean.js node_modules dist build .turbo",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "test": "vitest run --mode=node",
    "test:integration": "vitest run --mode=integration",
    "test:watch": "vitest --mode=node",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "dependencies": {
    "@byline/analytics": "workspace:*"
  },
  "peerDependencies": {
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@byline/analytics-conformance": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.4.2",
    "npm-run-all": "^4.1.5",
    "pg": "^8.23.0",
    "tsc-alias": "^1.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
