{
  "name": "@byline/analytics-agent",
  "private": false,
  "license": "MPL-2.0",
  "version": "4.16.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "Tiny dependency-free browser collector for Byline analytics",
  "keywords": [
    "cms",
    "analytics",
    "browser",
    "privacy",
    "cookieless"
  ],
  "homepage": "https://github.com/Byline-CMS/bylinecms.dev",
  "bugs": {
    "url": "https://github.com/Byline-CMS/bylinecms.dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byline-CMS/bylinecms.dev.git",
    "directory": "packages/analytics-agent"
  },
  "type": "module",
  "main": "dist/index.js",
  "index": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "dev": "chokidar 'src/**/*' -c 'npm-run-all build'",
    "build": "tsc -p tsconfig.json && node scripts/build-agent.js",
    "clean": "node scripts/clean.js node_modules dist build .turbo",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "test": "node scripts/build-agent.js && vitest run --mode=node",
    "test:watch": "vitest --mode=node",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js",
      "require": "./dist/source.js"
    },
    "./standalone.js": "./dist/b.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^26.4.0",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
