{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "stream",
  "concurrency": "25",
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "outputs": [],
      "env": ["NODE_ENV"],
      "persistent": true
    },
    "db:init": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "byline:generate": {
      "dependsOn": ["@byline/core#build", "@byline/richtext-lexical#build"],
      "outputs": ["byline/generated/collection-types.ts"]
    },
    "byline:generate:check": {
      "dependsOn": ["@byline/core#build", "@byline/richtext-lexical#build"],
      "outputs": []
    },
    "drizzle:generate": {
      "cache": false
    },
    "drizzle:migrate": {
      "cache": false
    },
    "dev:seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "byline/**/*.ts",
        "byline/**/*.tsx",
        "tsconfig.json"
      ]
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "env": [
        "BYLINE_CLI_MYSQL_ADMIN_URL",
        "BYLINE_CLI_POSTGRES_ADMIN_URL",
        "BYLINE_DB_MYSQL_CONNECTION_STRING",
        "BYLINE_DB_POSTGRES_CONNECTION_STRING"
      ]
    },
    "preview": {
      "cache": false,
      "dependsOn": ["^preview"],
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["^start"],
      "persistent": true
    }
  },
  "globalEnv": []
}
