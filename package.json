{
  "name": "@byline/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "clean": "pnpm -r run clean && node scripts/clean node_modules .turbo",
    "db:init": "TURBO_UI=true turbo run db:init",
    "db:init:test": "cd packages/db-postgres/src/database && ./db_init_test.sh",
    "db:init:test:mysql": "cd packages/db-mysql/src/database && ./db_init_test.sh",
    "byline:generate": "turbo run byline:generate",
    "byline:generate:check": "turbo run byline:generate:check",
    "check:native-sql-history": "node scripts/check-native-sql-history.mjs",
    "docs:check": "pnpm --filter @byline/webapp docs:check",
    "drizzle:generate": "turbo run drizzle:generate",
    "drizzle:migrate": "turbo run drizzle:migrate",
    "drizzle:rekey": "turbo run drizzle:rekey",
    "drizzle:rekey:test": "turbo run drizzle:rekey:test",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "preview": "turbo run preview",
    "start": "turbo run start",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "dev": "turbo run dev",
    "lint": "turbo run lint --continue",
    "knip": "knip --no-config-hints",
    "knip:exports": "node scripts/check-public-exports.mjs",
    "knip:exports:update": "node scripts/check-public-exports.mjs --update",
    "knip:exports:report": "knip --config knip.exports.json --workspace './packages/*' --no-config-hints --no-exit-code --max-show-issues 100",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:scripts": "node --test scripts/*.test.mjs",
    "version-packages": "changeset version",
    "release:tag": "turbo run build --filter=\"./packages/*\" && changeset tag",
    "release:npm": "turbo run build --filter=\"./packages/*\" && changeset publish",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm byline:generate:check && pnpm knip && pnpm knip:exports"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched --diagnostic-level=error"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "^3.0.3",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "dependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
