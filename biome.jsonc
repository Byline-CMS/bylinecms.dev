{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/tailwind.css",
      "!**/public/b.js",
      "!**/routeTree.gen.ts",
      "!**/generated/collection-types.ts",
      "!**/vendor",
      // Drizzle-managed migration snapshots — regenerated by
      // `pnpm drizzle:generate`; hand-formatting churns them on every
      // `pnpm lint --write` run.
      "!**/migrations/meta",
      // Package-manager output — never hand-formatted.
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "includes": ["**", "!**/dist", "!**/build", "!**/node_modules", "!**/.cache"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":URL:",
              ":BLANK_LINE:",
              ["react"],
              ["next/**", "@tanstack/**"],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ["~/**"],
              ":BLANK_LINE:",
              {
                "type": false
              }
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "useUniqueElementIds": "off"
      },
      // `pnpm lint` runs with --unsafe, which applies these rules' fixes
      // automatically. Both change behaviour: `x!` → `x?.` lets undefined
      // through, and ternary → Math.min/max coerces strings (e.g. ISO days)
      // to NaN. Keep the diagnostics, never the auto-fix.
      "complexity": {
        "useMathMinMax": { "level": "info", "fix": "none" }
      },
      "style": {
        "noNonNullAssertion": { "level": "info", "fix": "none" },
        "useSelfClosingElements": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off",
        "noArrayIndexKey": "warn"
      },
      "performance": {
        "noDelete": "off"
      },
      "a11y": {
        "useSemanticElements": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  // Test harness components deliberately close over per-test state and are
  // defined once per test, so the remount hazard this rule guards against
  // does not apply.
  "overrides": [
    {
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": { "noComponentHookFactories": "off" }
        }
      }
    }
  ],
  // Biome 2.6 added Markdown and YAML support, on by default. Keep both off:
  // CHANGELOGs are written by changesets, docs are checked by `pnpm docs:check`,
  // and YAML here is workflow/workspace config that Biome has never owned.
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  }
}
